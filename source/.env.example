# Set these in Vercel → Project → Settings → Environment Variables (never commit real values)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key – safe for browsers
SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret key (sb_secret_...) or legacy service_role key – SERVER ONLY, keep private
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# Optional: the AI key can also be pasted later in Admin. Format id.secret
ZHIPU_API_KEY=
# Optional: defaults to mishtiaqkhursheed@gmail.com
OWNER_EMAIL=mishtiaqkhursheed@gmail.com
